# Copia este archivo como .env y completa los valores. El .env NUNCA se sube.
# entorno: desarrollo | produccion  (en produccion la cookie va con Secure)
ENTORNO=desarrollo
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Conexión a MariaDB/MySQL. Para Platino solo se cambian estas líneas.
BD_HOST=127.0.0.1
BD_PUERTO=3306
BD_USUARIO=titicaca_app
BD_CONTRASENA=
BD_NOMBRE=titicaca_vivo
BD_NOMBRE_PRUEBAS=titicaca_vivo_pruebas

# Reglas configurables
# RN-05: minutos que se guarda el cupo de una reserva Yape/Plin sin pago reportado
MINUTOS_VENCIMIENTO_PAGO=120
# P3 (F0): soles que recibe la familia anfitriona por persona y noche (por confirmar con Giant Trip)
PAGO_FAMILIA_PERSONA_NOCHE=40.00

# Cobro con Yape/Plin (lo ve el turista al pagar). Números FICTICIOS para pruebas.
YAPE_NUMERO=900000100
PLIN_NUMERO=900000100
TITULAR_COBRO=Agencia de prueba (dato ficticio)
# URL que va dentro del QR del boleto, p. ej. http://192.168.1.10:8080 (vacía = la del servidor)
URL_PUBLICA=

# Sesión del personal: se cierra sola tras estos minutos sin actividad (D-110)
SESION_INACTIVA_MIN=30

# Correo para «¿Olvidaste tu contraseña?» (D-111). Con CORREO_SIMULAR=1 no sale nada a
# internet: el código aparece en la ventana del servidor (sirve para la demostración).
# Para enviarlo de verdad con Gmail: activa la verificación en 2 pasos, crea una
# "contraseña de aplicación" en tu cuenta de Google, ponla en SMTP_CONTRASENA y CORREO_SIMULAR=0.
# Prueba la configuración con:  flask correo probar tu.correo@gmail.com
CORREO_SIMULAR=1
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=

# Respaldos de la base (D-116): en la carpeta respaldos/ (fuera del ZIP de entrega y de git).
# Mientras el servidor está encendido crea uno automático cada RESPALDO_CADA_HORAS horas.
RESPALDO_AUTOMATICO=1
RESPALDO_CADA_HORAS=24
RESPALDOS_CONSERVAR=15

# APIs externas (v2.2), públicas y sin clave. Solo las llama el servidor; si no hay internet,
# la app funciona igual (sin esos datos). APIS_EXTERNAS=0 las apaga todas.
#   RENIEC (graphperu): el DNI completa los nombres en el formulario de reserva.
#   SUNAT (apis.net.pe): tipo de cambio del día para mostrar los precios en dólares.
#   Open-Meteo: clima de la bahía de Puno a la hora de cada zarpe.
#   Nager.Date: feriados del Perú en la lista de salidas.
APIS_EXTERNAS=1
APIS_TIMEOUT=4
RENIEC_API_URL=https://graphperu.daustinn.com/api/query
TIPO_CAMBIO_API_URL=https://api.apis.net.pe/v1/tipo-cambio-sunat
CLIMA_API_URL=https://api.open-meteo.com/v1/forecast
FERIADOS_API_URL=https://date.nager.at/api/v3/PublicHolidays

# Atención de la agencia (v2.6): salen en la página Contacto y en el pie de página.
# Vacío = no se muestra. El formulario de contacto llega a AGENCIA_CORREO o, si está vacío,
# a los operadores activos que tienen correo.
AGENCIA_CORREO=reservas@titicaca-vivo.example
AGENCIA_WHATSAPP=
AGENCIA_HORARIO=Todos los días, de 6:00 a 19:00
# Libro de reclamaciones (v2.8): la ley pide mostrar la razón social y el RUC del proveedor.
AGENCIA_RAZON_SOCIAL=Titicaca Vivo
AGENCIA_RUC=
